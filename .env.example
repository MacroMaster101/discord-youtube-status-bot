# Required
DISCORD_TOKEN=your_discord_bot_token_here
# Dashboard password: 8+ characters. Default or short passwords disable the dashboard login.
ADMIN_PASSWORD=
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_CHANNEL_ID=@YourChannelHandle

# Optional (all editable from the dashboard Configuration tab)
PREFIX=$
YOUTUBE_NOTIFY_CHANNEL_ID=
YOUTUBE_POLL_INTERVAL=300
PORT=8080

# Dashboard exposure (see SECURITY.md)
# DASHBOARD_BIND_ADDRESS=127.0.0.1   # keep the plain-HTTP dashboard off the public internet
# COMPOSE_PROFILES=tunnel            # also start the Cloudflare Tunnel for HTTPS access
# TUNNEL_TOKEN=
