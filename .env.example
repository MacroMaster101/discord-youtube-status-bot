# Required
DISCORD_TOKEN=your_discord_bot_token_here
# Dashboard password: 8+ characters. Default or short passwords disable the dashboard login.
ADMIN_PASSWORD=
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_CHANNEL_ID=@YourChannelHandle

# Optional (all editable from the dashboard Configuration tab)
PREFIX=$
YOUTUBE_NOTIFY_CHANNEL_ID=
YOUTUBE_POLL_INTERVAL=300
PORT=8080

# Dashboard exposure (see SECURITY.md)
# DASHBOARD_BIND_ADDRESS=0.0.0.0     # publish the plain-HTTP dashboard on every interface
#                                    # (default is 127.0.0.1; only behind a security group)
# COMPOSE_PROFILES=tunnel            # also start the Cloudflare Tunnel for HTTPS access
# TUNNEL_TOKEN=

# Dashboard sign-in. ADMIN_PASSWORD above always works; these add two more doors
# and are what you want once the dashboard is reachable from the internet.
# See the "Signing in" section of the README for how to obtain each value.

# Discord OAuth: an account that administers a server this bot is in may sign in.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://your-tunnel-hostname/auth/discord/callback
# FLASK_SECRET_KEY=                  # any long random string; without it a restart
#                                    # interrupts sign-ins that are mid-flight

# Cloudflare Access: the signed Cf-Access-Jwt-Assertion is verified on every
# request, so no password or Discord round trip is involved. Both are required;
# with only one set, Access sign-in stays off rather than half-trusting a header.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=                     # Application Audience (AUD) tag of the Access app
